# ==============================================================================
# 🚀 POSENUTRI - MASTER ENVIRONMENT VARIABLES GUIDE
# ==============================================================================
# This is a reference for all environment variables needed across the monorepo.
# In a local setup, you should copy these variables into the specific `.env` 
# files for each microservice (e.g. server/.env, client/.env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 🟢 SERVER (Backend Node.js API) -> Place in `server/.env`
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/pose_nutri

# Authentication (Make this a long, random string)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# URLs
AI_SERVICE_URL=http://localhost:8000

# AI Features (REQUIRED for generating AI Plans)
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 🔵 CLIENT (Frontend React/Vite) -> Place in `client/.env`
# ------------------------------------------------------------------------------
# Note: Vite requires the `VITE_` prefix for variables to be accessible in React
VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# 🟡 AI SERVICE (Python FastAPI) -> Place in `ai_service/.env`
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000

# Security (CORS)
ALLOWED_ORIGIN=http://localhost:5000

# YOLOv8 Model Configuration
FOOD_MODEL_PATH=models/food_yolov8n.pt
